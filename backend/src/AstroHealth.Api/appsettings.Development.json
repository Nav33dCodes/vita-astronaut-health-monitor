{
  // Zero-setup fallback. Point at Neon with user-secrets (never commit credentials):
  //   dotnet user-secrets set "Database:Provider" "Postgres" --project src/AstroHealth.Api
  //   dotnet user-secrets set "ConnectionStrings:Default" "<neon connection string>" --project src/AstroHealth.Api
  "ConnectionStrings": {
    "Default": "Data Source=astrohealth-local.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "Seed": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Simulator": {
    "Enabled": true,
    "IntervalSeconds": 5,
    "EpisodeProbability": 0.003
  }
}
